generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())
  numericId String @unique
  name String
  email String? @unique
  passwordHash String
  role String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  createdProcesses Process[] @relation("Creator")
  assignedProcesses Process[] @relation("Assignee")
  actions ProcessAction[]
  messages Message[]
  participations ProcessParticipant[]
}

model Process {
  id String @id @default(cuid())
  number String @unique
  title String
  description String
  facts String?
  crimes String?
  status String @default("RASCUNHO")
  pausedStatus String?
  instance String @default("PRIMEIRA")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  judgeDueAt DateTime?
  defenseDueAt DateTime?
  defenseExtensionDays Int @default(0)
  hearingAt DateTime?
  decisionAt DateTime?
  creatorId String
  assignedToId String?
  creator User @relation("Creator", fields: [creatorId], references: [id])
  assignedTo User? @relation("Assignee", fields: [assignedToId], references: [id])
  attachments Attachment[]
  actions ProcessAction[]
  messages Message[]
  participants ProcessParticipant[]
}

model Attachment {
  id String @id @default(cuid())
  name String
  path String
  mimeType String
  createdAt DateTime @default(now())
  processId String
  process Process @relation(fields: [processId], references: [id], onDelete: Cascade)
}

model ProcessAction {
  id String @id @default(cuid())
  type String
  note String?
  createdAt DateTime @default(now())
  processId String
  userId String
  process Process @relation(fields: [processId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
}

model Message {
  id String @id @default(cuid())
  body String
  createdAt DateTime @default(now())
  processId String
  userId String
  process Process @relation(fields: [processId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
}

model ProcessParticipant {
  id String @id @default(cuid())
  role String
  processId String
  userId String
  process Process @relation(fields: [processId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
  @@unique([processId, userId])
}
